# Copy to secrets.yaml — shared across all room YAMLs unless noted.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
access_point_password: "your-ap-password"
ota_password: "your-ota-password"
web_server_username: "admin"
web_server_password: "your-web-password"

# One unique API encryption key per ESP (generate in ESPHome dashboard or: openssl rand -base64 32)
hvac_living__encryption_key: "living-key-here"
hvac_bedroom__encryption_key: "bedroom-key-here"
hvac_kitchen__encryption_key: "kitchen-key-here"
hvac_master__encryption_key: "master-key-here"
hvac_office__encryption_key: "office-key-here"
